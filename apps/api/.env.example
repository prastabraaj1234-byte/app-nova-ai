# Nova AI Backend Gateway Environment Template
# IMPORTANT: Copy this file to '.env' in this directory (apps/api/.env)
# Do NOT commit '.env' to version control. It is already included in .gitignore.

# Environment Mode: local | development | staging | production
ENVIRONMENT=local
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
MAX_REQUEST_SIZE_BYTES=10485760  # 10 MB limit per request body

# Database Configuration (Local development default using PostgreSQL + pgvector in Docker)
# For local SQLite in-memory / file dev without Docker, use: sqlite+aiosqlite:///./nova_local.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nova_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# CORS Trusted Origins (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:3000,http://localhost:8000,capacitor://localhost

# Future Phase Placeholders (Do not add real credentials here; place in your local apps/api/.env file when needed)
GEMINI_API_KEY=your_gemini_api_key_placeholder
FIREBASE_PROJECT_ID=your_firebase_project_id_placeholder
